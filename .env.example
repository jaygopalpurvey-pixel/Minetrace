# MineTrace Phase 1 Environment Configuration

# Application settings
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Database & Storage
# By default stores in local SQLite database inside data/
DATABASE_URL=sqlite:///./data/minetrace.db
DATA_DIR=./data

# UN Comtrade API Configuration
# Optional: primary/secondary subscription key for v1 UN Comtrade API if available
COMTRADE_API_KEY=
COMTRADE_BASE_URL=https://comtradeapi.un.org/public/v1/preview/C/A/HS
# Comma-separated commodity codes (HS codes). Default focuses on Lithium:
# 283691: Lithium carbonates
# 282520: Lithium hydroxide and oxide
# 253090: Other mineral substances (spodumene/lepidolite ores)
# 850760: Lithium-ion accumulators
DEFAULT_COMMODITY_CODES=283691,282520,253090,850760

# OFAC Sanctions Data Configuration
# Official US Treasury OFAC SDN Data Sources
OFAC_SDN_CSV_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.CSV
OFAC_CONS_CSV_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/CONS_PRIM.CSV
# Request timeouts (in seconds)
REQUEST_TIMEOUT_SECONDS=30

# Phase 6: Local RAG, ChromaDB & Ollama Configuration
CHROMA_PERSIST_DIR=./data/chroma
DOCUMENTS_DIR=./data/documents
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
EMBEDDING_MODEL=nomic-embed-text:latest
RAG_TOP_K=3
RAG_TIMEOUT_SECONDS=60

# Phase 7: Printable PDF Evidence Reports
REPORTS_DIR=./data/reports
